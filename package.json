{
    "name": "crud-api",
    "version": "1.0.0",
    "scripts": {
      "start:dev": "ts-node-dev --respawn src/index.ts",
      "start:prod": "npm run build && node dist/index.js",
      "start:multi": "ts-node src/cluster.ts",
      "build": "tsc && webpack --config webpack.config.js",
      "test": "jest",
      "lint": "eslint . --ext .ts",
      "format": "prettier --write ."
    },
    "dependencies": {
      "dotenv": "^16.4.5",
      "express": "^4.21.1",
      "uuid": "^10.0.0"
    },
    "devDependencies": {
      "@types/express": "^4.17.21",
      "@types/jest": "^29.5.13",
      "@types/node": "^22.7.4",
      "@types/supertest": "^6.0.2",
      "@types/uuid": "^10.0.0",
      "@typescript-eslint/eslint-plugin": "^8.8.0",
      "@typescript-eslint/parser": "^8.8.0",
      "cross-env": "^7.0.3",
      "eslint": "^8.57.1",
      "jest": "^29.7.0",
      "nodemon": "^3.1.7",
      "prettier": "^3.3.3",
      "supertest": "^7.0.0",
      "ts-jest": "^29.2.5",
      "ts-node": "^10.9.2",
      "ts-node-dev": "^2.0.0",
      "typescript": "^5.6.3",
      "webpack": "^5.95.0",
      "webpack-cli": "^5.1.4"
    }
  }